# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Criptografia de tokens (gerar com: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=

# Anthropic (camada Think — Claude escreve os prompts de imagem por slide)
ANTHROPIC_API_KEY=

# Modelos da camada Think (opcionais — abaixo os defaults do código):
#   Texto (caption/hooks/hashtags) via OpenAI:
# THINK_TEXT_MODEL=gpt-4.1-mini
#   Prompts de slide via Anthropic (segura contexto longo):
# THINK_PROMPT_MODEL=claude-sonnet-4-6

# OpenAI — DALL-E 3 (camada Make, provider 'dalle')
OPENAI_API_KEY=

# Flux via Fal.ai (camada Make, provider 'fal') — fal.ai/dashboard/keys
FAL_KEY=

# Flux via Replicate (camada Make, provider 'replicate') — replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Meta / Instagram Graph API
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://seudominio.vercel.app/api/auth/meta/callback

# YouTube Data API v3 (Sense)
YOUTUBE_API_KEY=

# Cron secret — protege as rotas de cron contra chamadas externas
CRON_SECRET=

# Webhook Meta (comment-to-DM, Fase 8) — string aleatória que você define e
# repete no painel do app Meta ao assinar o campo 'comments'.
META_WEBHOOK_VERIFY_TOKEN=
